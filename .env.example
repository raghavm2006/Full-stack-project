# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=emailorbit
DB_USER=emailorbit_user
DB_PASSWORD=replace-with-real-password

# --- Google OAuth / Gmail API (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# Fernet key used to encrypt stored OAuth tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Only for local HTTP development (Google OAuth normally requires HTTPS).
# Never set this in production.
OAUTHLIB_INSECURE_TRANSPORT=1

# --- Smart replies (Phase 9) ---
# Optional. Leave blank to use the deterministic template fallback with
# no external API calls at all. Set a real key to get LLM-generated
# reply suggestions instead (app/blueprints/smart_replies falls back to
# templates automatically if this is missing, invalid, or the call fails).
ANTHROPIC_API_KEY=
SMART_REPLY_MODEL=claude-3-5-haiku-latest
